# Editors and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python workflow helpers and standalone demos (not the DevMeld runtime)
__pycache__/
*.py[cod]

# Rust build output; Cargo.lock is intentionally versioned after setup
/target/
*.rs.bk
.env
.env.*
!.env.example

# Local scratch files
*.tmp
*.log

# Shop demo: runtime data and locally generated context are not source files
/examples/shop/data/
/examples/shop/.devmeld/
/examples/shop/CONTEXT.md
